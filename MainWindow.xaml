<Window x:Class="Ravenhawk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:Ravenhawk.Models" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" Title="{DynamicResource WindowTitle}" Icon="/Hawkstore;component/Assets/hawkstore.ico" Width="1280" Height="820" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}" SizeChanged="Window_SizeChanged">
  <Grid Background="{StaticResource PageBackground}">
    <Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="52,28,52,22">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Width="58" Height="58" Source="/Hawkstore;component/Assets/hawkstore-icon.png" Stretch="Uniform" Margin="0,0,16,0"/>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="Hawkstore" FontSize="38" FontWeight="Light"/><TextBlock Text="{DynamicResource Subtitle}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="2,1,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="HomeButton" Style="{StaticResource ActiveNavButton}" Content="{DynamicResource NavHome}" Click="HomeButton_Click" MinWidth="90" Padding="12,10"/>
        <Button x:Name="StoreButton" Style="{StaticResource NavButton}" Content="{DynamicResource NavStore}" Click="StoreButton_Click" MinWidth="90" Padding="12,10"/>
        <Button x:Name="InstallButton" Style="{StaticResource NavButton}" Content="{DynamicResource NavInstall}" ToolTip="{DynamicResource InstallTooltip}" Click="InstallButton_Click" MinWidth="140" Padding="12,10"/>
        <Button x:Name="LanguageButton" Style="{StaticResource NavButton}" Content="{DynamicResource LanguageSwitch}" Click="LanguageButton_Click" MinWidth="92" Padding="12,10"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="52,0,52,18">
      <Grid x:Name="HomeView">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
          <StackPanel Orientation="Horizontal"><TextBlock Text="▰" FontSize="21" VerticalAlignment="Center" Margin="0,0,11,0"/><TextBlock Text="{DynamicResource InstalledPlugins}" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="PluginCountText" Foreground="{StaticResource TextSecondary}" FontSize="14" VerticalAlignment="Bottom" Margin="13,0,0,3"/></StackPanel>
          <TextBlock x:Name="BepInExStateText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid><TextBox x:Name="SearchBox" Height="42" Padding="39,8,12,8" TextChanged="SearchBox_TextChanged"/><TextBlock Text="⌕" FontSize="22" Foreground="#B0B0B0" Margin="13,0,0,2" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/><TextBlock x:Name="SearchHint" Text="{DynamicResource HomeSearchHint}" Foreground="#737373" Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
          <TextBox Grid.Column="2" x:Name="GamePathBox" Height="42" ToolTip="{DynamicResource GamePathTooltip}"/>
          <Button Grid.Column="3" Content="{DynamicResource ChooseFolder}" Height="42" Margin="10,0,0,0" Click="BrowseButton_Click"/>
          <Button Grid.Column="4" x:Name="SortButton" Content="{DynamicResource SortUpdatedButton}" Height="42" Margin="8,0,0,0" Click="SortButton_Click">
            <Button.ContextMenu>
              <ContextMenu Placement="Bottom">
                <MenuItem Header="{DynamicResource SortUpdated}" Tag="Updated" Click="SortOption_Click"/>
                <MenuItem Header="{DynamicResource SortName}" Tag="Name" Click="SortOption_Click"/>
                <MenuItem Header="{DynamicResource SortSize}" Tag="Size" Click="SortOption_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Grid.Column="5" Content="{DynamicResource Refresh}" Height="42" Margin="8,0,0,0" Click="RefreshButton_Click"/>
        </Grid>
        <Grid Grid.Row="2">
          <TextBlock x:Name="EmptyListText" Text="{DynamicResource NoPlugins}" FontSize="18" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          <ListBox x:Name="PluginList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,16,16"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type models:PluginItem}">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18" MinHeight="158">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,11,0,10"><TextBlock Text="{Binding DescriptionText}" Foreground="#929292" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38"/><TextBlock Foreground="#707070" FontSize="12" Margin="0,5,0,0"><Run Text="{Binding Kind, Mode=OneWay}"/><Run Text="{DynamicResource SupportsPrefix}"/><Run Text="{Binding GameVersionText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SizeText, Mode=OneWay}"/></TextBlock></StackPanel>
                    <Grid Grid.Row="2"><Button Content="{DynamicResource Details}" HorizontalAlignment="Left" Click="DetailsButton_Click"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding StateText}" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" VerticalAlignment="Center"/><primitives:ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=OneWay}" Click="CardToggle_Click"/></StackPanel></Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>

      <Grid x:Name="StoreView" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
          <StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="21" VerticalAlignment="Center" Margin="0,0,11,0"/><TextBlock Text="{DynamicResource StoreTitle}" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="StoreCountText" Foreground="{StaticResource TextSecondary}" FontSize="14" VerticalAlignment="Bottom" Margin="13,0,0,3"/></StackPanel>
          <TextBlock Text="{DynamicResource StoreSource}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid><TextBox x:Name="StoreSearchBox" Height="42" Padding="39,8,12,8" TextChanged="StoreSearchBox_TextChanged"/><TextBlock Text="⌕" FontSize="22" Foreground="#B0B0B0" Margin="13,0,0,2" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/><TextBlock x:Name="StoreSearchHint" Text="{DynamicResource StoreSearchHint}" Foreground="#737373" Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
          <Button Grid.Column="1" x:Name="StoreRefreshButton" Content="{DynamicResource RefreshStore}" Height="42" Margin="10,0,0,0" Click="StoreRefreshButton_Click"/>
        </Grid>
        <Grid Grid.Row="2">
          <TextBlock x:Name="StoreEmptyText" Text="{DynamicResource StoreEmpty}" FontSize="18" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          <ListBox x:Name="StoreList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,16,16"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type models:StorePackageItem}">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18" MinHeight="184">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding VersionText}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,7,0,0"/></StackPanel><TextBlock Text="{Binding BadgeText}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" FontSize="12"/></Grid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,12"><TextBlock Text="{Binding Description}" Foreground="#929292" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58"/><TextBlock Text="{Binding CategoryText}" Foreground="#707070" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="{Binding GameVersionText}" Foreground="#707070" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                    <Grid Grid.Row="2"><TextBlock Text="{Binding InstallState}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/><Button Style="{StaticResource PrimaryButton}" Content="{Binding ActionText}" IsEnabled="{Binding CanInstall}" HorizontalAlignment="Right" Click="InstallStoreButton_Click" MinWidth="92"/></Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>

      <Grid x:Name="DetailsView" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Content="←" FontSize="22" Padding="13,5" Click="BackButton_Click" Margin="0,0,16,0"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="DetailTitleText" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="EntryPathText" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="DetailStateText" Foreground="{StaticResource TextSecondary}" Margin="0,0,11,0" VerticalAlignment="Center"/><primitives:ToggleButton x:Name="DetailToggle" Style="{StaticResource ToggleSwitch}" Click="DetailsToggle_Click"/></StackPanel>
        </Grid>
        <Border Grid.Row="1" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Margin="0,0,0,24"><Grid Width="72" HorizontalAlignment="Left"><TextBlock Text="{DynamicResource Details}" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/><Border Background="{StaticResource Accent}" Height="2" VerticalAlignment="Bottom" Width="72"/></Grid></Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <Grid MaxWidth="860" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="3" Text="{DynamicResource ReadOnlyNotice}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,18"/>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3"><Label Content="{DynamicResource FieldDisplayName}"/><TextBox x:Name="NameBox" IsReadOnly="True"/></StackPanel>
            <StackPanel Grid.Row="2" Margin="0,17,0,0"><Label Content="{DynamicResource FieldAuthor}"/><TextBox x:Name="AuthorBox" IsReadOnly="True"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2" Margin="0,17,0,0"><Label Content="{DynamicResource FieldPluginVersion}"/><TextBox x:Name="VersionBox" IsReadOnly="True"/></StackPanel>
            <StackPanel Grid.Row="3" Margin="0,17,0,0"><Label Content="{DynamicResource FieldSupportedVersion}"/><TextBox x:Name="GameVersionBox" IsReadOnly="True"/></StackPanel><StackPanel Grid.Row="3" Grid.Column="2" Margin="0,17,0,0"><Label Content="{DynamicResource FieldPluginSize}"/><TextBox x:Name="SizeBox" IsReadOnly="True"/></StackPanel>
            <StackPanel Grid.Row="4" Margin="0,17,0,0"><Label Content="{DynamicResource FieldSteamId}"/><TextBox x:Name="SteamIdBox" IsReadOnly="True"/></StackPanel><StackPanel Grid.Row="4" Grid.Column="2" Margin="0,17,0,0"><Label Content="{DynamicResource FieldSteamVerification}"/><TextBox x:Name="SteamVerificationBox" IsReadOnly="True"/></StackPanel>
            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,17,0,0"><Label Content="{DynamicResource FieldLastUpdated}"/><TextBox x:Name="UpdatedBox" IsReadOnly="True" Foreground="{StaticResource TextSecondary}"/></StackPanel>
            <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,17,0,0"><Label Content="{DynamicResource FieldDescription}"/><TextBox x:Name="DescriptionBox" Height="104" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/></StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#262626" BorderBrush="#383838" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="{DynamicResource Ready}" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="52,0" FontSize="12"/></Border>
  </Grid>
</Window>
